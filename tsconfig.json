{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    // test/e2e/hook.js runs from the e2e build's root, so it imports as if it sat in extension/.
    "rootDirs": ["extension", "test/e2e"]
  },
  "include": ["extension/**/*.js", "test/**/*.js", "test/**/*.mjs", "scripts/**/*.mjs", "store/**/*.mjs", "eslint.config.js"],
  "exclude": ["extension/vendor/**"]
}
