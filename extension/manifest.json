{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_optionsTitle__",
    "default_icon": {
      "16": "icons/toolbar/light-16.png",
      "32": "icons/toolbar/light-32.png",
      "48": "icons/toolbar/light-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "rotate-right": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "__MSG_commandRotateRight__"
    },
    "rotate-left": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "__MSG_commandRotateLeft__"
    },
    "reset": {
      "suggested_key": {
        "default": "Alt+Shift+0",
        "mac": "Alt+Shift+0"
      },
      "description": "__MSG_commandReset__"
    },
    "open-viewer": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "__MSG_commandOpenViewer__"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/keys.js",
        "shared/page.js",
        "shared/rotate.js",
        "shared/transform.js",
        "shared/settings.js",
        "vendor/extension-kit/sites/sites.js",
        "vendor/extension-kit/settings/store.js",
        "vendor/extension-kit/settings/storage.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
